#include <jni.h>
#include <string>
#include "hand_detect_interface.h"   // 你的接口

extern "C" {

// 设置配置文件路径
JNIEXPORT void JNICALL
Java_com_example_handdetect_HandDetectJNI_setConfigPath(
        JNIEnv* env,
        jclass clazz,
        jstring jpath) {

    const char* cpath = env->GetStringUTFChars(jpath, nullptr);
    hand_detect_set_config_path(std::string(cpath));
    env->ReleaseStringUTFChars(jpath, cpath);
}


// 调用 hand_detect_interface
JNIEXPORT jboolean JNICALL
Java_com_example_handdetect_HandDetectJNI_detectNV21(
        JNIEnv* env,
        jclass clazz,
        jbyteArray jnv21,
        jint width,
        jint height) {

    jbyte* nv21_data = env->GetByteArrayElements(jnv21, nullptr);
    jsize length = env->GetArrayLength(jnv21);

    if (length < width * height * 3 / 2) {
        env->ReleaseByteArrayElements(jnv21, nv21_data, JNI_ABORT);
        return JNI_FALSE;  // 数据不足
    }

    AndroidImageNV21 img;
    img.image_input_nv21 = reinterpret_cast<uint8_t*>(nv21_data);
    img.image_width = width;
    img.image_height = height;

    bool result = hand_detect_interface(&img);

    // JNI_ABORT：不需要把数据拷回 Java
    env->ReleaseByteArrayElements(jnv21, nv21_data, JNI_ABORT);

    return result ? JNI_TRUE : JNI_FALSE;
}

}
