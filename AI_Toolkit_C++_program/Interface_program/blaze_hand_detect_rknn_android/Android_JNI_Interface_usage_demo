#include <jni.h>
#include <string>
#include "hand_detect_interface.hpp"

// JNI 方法：接收 NV21 数据、宽、高，返回 boolean
extern "C"
JNIEXPORT jboolean JNICALL
Java_com_example_handdetect_MainActivity_nativeHandDetect(
        JNIEnv* env,
        jobject /* this */,
        jbyteArray nv21_data,
        jint width,
        jint height) {

    jbyte* nv21_ptr = env->GetByteArrayElements(nv21_data, nullptr);
    if (!nv21_ptr) return JNI_FALSE;

    AndroidImageNV21 img;
    img.image_input_nv21 = reinterpret_cast<uint8_t*>(nv21_ptr);
    img.image_width = width;
    img.image_height = height;

    bool result = hand_detect_interface(&img);

    env->ReleaseByteArrayElements(nv21_data, nv21_ptr, JNI_ABORT); // 不修改原数组

    return result ? JNI_TRUE : JNI_FALSE;
}
